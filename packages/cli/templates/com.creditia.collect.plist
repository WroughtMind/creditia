<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  后台定时采集证据（macOS launchd）。把 creditia-core 的实际路径填进去，然后：
    cp com.creditia.collect.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.creditia.collect.plist
  每小时对作品库里的全部项目运行一次 `creditia-core collect --all`，只采集证据，不改仓库。
  Linux 用 systemd user timer（OnUnitActiveSec=1h）跑同一条命令；Windows 用任务计划程序。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.creditia.collect</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/creditia-core</string>
    <string>collect</string>
    <string>--all</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/tmp/creditia-collect.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/creditia-collect.log</string>
</dict>
</plist>
